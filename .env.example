# Groq (model provider) — https://console.groq.com/keys
GROQ_API_KEY=

# RapidAPI Sky Scrapper (flight search) — https://rapidapi.com/apiheya/api/sky-scrapper
# Subscribe to a plan (a free Basic tier is available) on the Sky Scrapper API page,
# then copy your RapidAPI key here. This is a live flight-data aggregator, not an
# airline/GDS booking system — prices/availability are not guaranteed bookable
# (see searchFlights tool description / README for details).
RAPIDAPI_KEY=
RAPIDAPI_HOST=sky-scrapper.p.rapidapi.com
